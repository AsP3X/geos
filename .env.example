# Geos environment configuration. Copy to `.env` and fill in real values.
# Or run `./scripts/gen-env.sh` to bootstrap `.env` and auto-generate secrets.
# `.env` is git-ignored; never commit real secrets.

# ── PostgreSQL (PostGIS + pgvector) ──────────────────────────────────────────
POSTGRES_USER=geos
POSTGRES_PASSWORD=geos
POSTGRES_DB=geos
POSTGRES_PORT=5432
# Used by the Rust services (host value for local, non-Docker runs):
DATABASE_URL=postgres://geos:geos@localhost:5432/geos

# ── Meilisearch ──────────────────────────────────────────────────────────────
MEILI_MASTER_KEY=change-me-to-a-32+char-random-string
MEILI_ENV=development
MEILI_PORT=7700
MEILI_URL=http://localhost:7700

# ── Object storage (nebular-os) ──────────────────────────────────────────────
# Both secrets must be at least 32 characters.
NOS_JWT_SECRET=change-me-to-a-32+char-random-string
NOS_SIGNING_SECRET=change-me-to-a-32+char-random-string
STORAGE_PORT=9000
STORAGE_URL=http://localhost:9000

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=8080
GEOS_BIND_ADDR=0.0.0.0:8080
# JWT signing secret for Geos auth (min 32 chars):
JWT_SECRET=change-me-to-a-32+char-random-string
# Comma-separated browser origins allowed to call the API cross-origin. Required
# when the frontend and API are on different public hosts (e.g. NPM split-host).
# Example: https://geos.corespace.de
GEOS_CORS_ORIGINS=

# ── Imagery tile proxy (Cesium globe) ────────────────────────────────────────
# The API caches Sentinel-2 imagery tiles in nebular-os and lazily backfills
# misses from EOX (CC-BY 4.0). NOS_JWT_SECRET (above) signs the service tokens
# the API uses to read/write the tile bucket.
# Object-storage bucket for cached imagery/contour tiles:
TILES_BUCKET=geos-tiles
# Max served zoom level (~38 m/px at z12 for Sentinel-2). Enforced server-side
# and reported to the globe via /api/v1/tiles/session, so the Cesium client caps
# its maximumLevel to match and never requests deeper tiles. Lower this on
# storage-constrained machines (e.g. 6-8) to shrink how many tiles get cached:
TILES_MAX_ZOOM=12
# Upstream imagery template ({z}/{x}/{y} placeholders). Default: EOX Sentinel-2
# cloudless ("Sentinel-2 cloudless by EOX IT Services GmbH", CC-BY 4.0):
IMAGERY_UPSTREAM_URL=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2024_3857/default/GoogleMapsCompatible/{z}/{y}/{x}.jpg

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=4173
# Build-time API URL for local `pnpm dev` only (optional). Prefer leaving empty
# so Vite proxies /api to the backend.
# VITE_API_BASE_URL=http://localhost:8080
# Runtime API URL for the Docker frontend (no trailing slash). Injected into
# /config.js at container start — no rebuild needed when this changes.
# Leave empty when NPM serves frontend + /api on the same public host.
# Set when the API is on a separate public host, e.g. https://api.geos.example.com
GEOS_API_BASE_URL=
# Offline contour basemap path served to the Cesium globe (generated by
# scripts/gen-contour-tiles.sh into frontend/public/contours). Override only to
# serve the fallback tiles from elsewhere (e.g. the tile proxy's contours/ prefix):
# VITE_CONTOUR_TILES_URL=/contours/{z}/{x}/{y}.jpg

# ── AI providers (optional; leave blank for air-gapped/Ollama-only mode) ──────
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Workers / historical backfill ────────────────────────────────────────────
# Connectors backfill history newest -> oldest in resumable chunks, tracked in
# connectors_state and surfaced via GET /api/v1/connectors. Defaults work out of
# the box; override to tune depth and politeness.
# BACKFILL_ENABLED=true
# Earliest event time to pull for USGS (RFC3339 or YYYY-MM-DD). Default is
# 1900-01-01 (the full ANSS catalog); set a recent date for a shorter window.
# NWS is bounded to the public ~7-day archive regardless of this value.
# BACKFILL_USGS_START=1900-01-01
# Time span fetched per chunk in hours (default 6). Legacy: BACKFILL_CHUNK_DAYS.
# BACKFILL_CHUNK_HOURS=6
# Max chunks processed per backfill batch inside one task run.
# BACKFILL_CHUNKS_PER_RUN=4
# Politeness delay between outbound connector requests, in milliseconds.
# BACKFILL_REQUEST_DELAY_MS=0
# Minimum earthquake magnitude pulled during USGS backfill. Default (unset/empty)
# pulls ALL magnitudes. Set a positive number to floor out micro-quakes.
# BACKFILL_USGS_MIN_MAGNITUDE=
# Max concurrent in-flight USGS requests during backfill (default 4).
# BACKFILL_USGS_MAX_CONCURRENCY=4
# Live poll cadence and worker parallelism.
# WORKER_POLL_INTERVAL_SECS=60
# WORKER_CONCURRENCY=2

# ── Logging ──────────────────────────────────────────────────────────────────
RUST_LOG=info
